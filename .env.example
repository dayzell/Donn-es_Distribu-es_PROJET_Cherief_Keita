# Copier ce fichier en ".env" puis adapter les valeurs. Le fichier ".env" n'est jamais versionné.
POSTGRES_USER=retailpulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=retailpulse

# Ports exposés sur la machine hôte (changer si déjà utilisés)
KAFKA_HOST_PORT=9092
POSTGRES_HOST_PORT=5432

# Simulation commerciale (facultatif, valeurs par défaut ci-dessous)
SIM_INTERVAL_MIN=0.5
SIM_INTERVAL_MAX=2.0
SIM_FAILURE_RATE=0.10
SIM_CANCEL_RATE=0.05
SIM_MAX_ORDERS=0

# Spark Structured Streaming (facultatif, valeurs par défaut ci-dessous)
SPARK_UI_PORT=4040
SPARK_WATERMARK_DELAY=10 minutes
SPARK_TRIGGER_INTERVAL=10 seconds
